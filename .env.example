# ── Source: splunk ────────────────────────────────────────────────────────────
# Pull threat intel from a Splunk search via the REST API.
# Required:
# SPLUNK_URL=https://your-instance.splunkcloud.com:8089
# Auth — token (preferred):
# SPLUNK_TOKEN=your-api-token
# Auth — basic fallback:
# SPLUNK_USERNAME=admin
# SPLUNK_PASSWORD=your-password
# Optional — override the default search:
# SPLUNK_SEARCH=index=threat_intel | table _time, title, description, url, source
# SPLUNK_EARLIEST=-30d@d
# Runtime query policy (comma-separated exact index names):
# SPLUNK_ALLOWED_INDEXES=threat_intel,main,security
# SPLUNK_MAX_LOOKBACK_DAYS=90
# SPLUNK_MAX_RESULTS=500
# AGENT_AUDIT_LOG=/tmp/threat-intel-agent-audit.jsonl
# Field name mappings (if your data uses non-default field names):
# SPLUNK_FIELD_NAME=title
# SPLUNK_FIELD_DESC=description
# SPLUNK_FIELD_URL=url
# SPLUNK_FIELD_PUBLISHER=source
# SPLUNK_FIELD_TIME=_time
# TLS verification (set to false for self-signed certs):
# SPLUNK_VERIFY_SSL=true

# ── Live hunt config (splunk-hunter agent + /hunt-live command) ───────────────
# Reuses SPLUNK_URL + auth above. Optional focus passed to the agent:
# HUNT_FOCUS=Scattered Spider

# ── Source: opencti ───────────────────────────────────────────────────────────
# Fetch 30-day cloud/AI reports from an OpenCTI GraphQL instance.
# Required:
# OPENCTI_URL=http://your-opencti-host:8080/graphql
# OPENCTI_TOKEN=your-opencti-api-token
# Optional overrides:
# CUTOFF_DAYS=30
# RAW_OUT=/tmp/tw-30d.json
# PKL_OUT=/tmp/tw-30d-processed.pkl
# PUB_SIDECAR=/tmp/tw-30d-published.json

# ── Source: slack ─────────────────────────────────────────────────────────────
# Read threat intel messages from a Slack channel.
# Required:
# SLACK_TOKEN=xoxb-your-slack-bot-token
# SLACK_CHANNEL_ID=C0123456789
# Optional overrides:
# SLACK_LOOKBACK_DAYS=30
# PKL_OUT=/tmp/tw-30d-processed.pkl
# PUB_SIDECAR=/tmp/tw-30d-published.json

# ── Source: rss ───────────────────────────────────────────────────────────────
# Parse RSS/Atom feeds directly (no OpenCTI required).
# Optional — comma-separated list of feed URLs.
# If not set, sources/feeds.py supplies a curated default list of 30+ feeds.
# RSS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/
# Optional overrides:
# CUTOFF_DAYS=30
# PKL_OUT=/tmp/tw-30d-processed.pkl
# PUB_SIDECAR=/tmp/tw-30d-published.json

# ── Source: stix ──────────────────────────────────────────────────────────────
# Ingest STIX 2.x objects from a TAXII 2.x server, a local bundle file, or a
# bundle URL. At least one of TAXII_URL, STIX_FILE, or STIX_URL must be set.
# Multiple sources can be set at once — all are fetched and merged.
#
# TAXII server:
# TAXII_URL=https://otx.alienvault.com/taxii/
# TAXII_TOKEN=your-api-key-or-bearer-token
# TAXII_USERNAME=user                     # Basic auth (if no token)
# TAXII_PASSWORD=pass
# TAXII_COLLECTION=collection-id-or-title # Omit to use the first readable collection
# TAXII_API_ROOT=https://host/api/v1      # Override auto-discovered API root
#
# Raw STIX bundle URL (no TAXII wrapper):
# STIX_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json
#
# Local STIX bundle file:
# STIX_FILE=/path/to/bundle.json
#
# Shared optional overrides:
# STIX_VERIFY_SSL=true                    # Set false for self-signed certs
# STIX_LIMIT=500                          # Max objects per collection fetch
# CUTOFF_DAYS=30
# PKL_OUT=/tmp/tw-30d-processed.pkl
# PUB_SIDECAR=/tmp/tw-30d-published.json

# ── build.py output paths (all sources share these) ───────────────────────────
# HTML_OUT=/tmp/threat-watch.html
# JSON_OUT=/tmp/threat-watch-data.json
# Optional operator controls:
# ENVIRONMENT_PROFILE=data/environment-profile.json
# REVIEW_STATE_IN=data/review-state.json
# PUBLISH_MAX_TLP=TLP:AMBER
