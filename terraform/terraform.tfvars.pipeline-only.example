# ── Mode 1: Pipeline only ─────────────────────────────────────────────────────
# No OpenCTI. Pipeline runs against RSS feeds, STIX/TAXII, Splunk, or Slack.
# Lowest cost. No extra spoke. Aviatrix network routes egress for the pipeline
# EC2 only.
#
# Copy to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars — it is gitignored.

aws_region   = "us-east-1"
environment  = "prod"

# Aviatrix
aviatrix_admin_password   = "CHANGE_ME_strong_password_here"
aviatrix_customer_id      = "your-aviatrix-customer-id"
aviatrix_aws_account_name = "aws-primary"

# Networking
transit_vpc_cidr        = "10.0.0.0/23"
spoke_pipeline_vpc_cidr = "10.1.0.0/24"

# Instance sizing
controller_instance_type = "t3.large"
transit_gw_size          = "c5.xlarge"
spoke_gw_size            = "t3.small"
pipeline_instance_type   = "t3.medium"

# Pipeline — choose rss, stix, splunk, or slack
pipeline_source   = "rss"
pipeline_schedule = "cron(0 6 * * ? *)"   # daily at 06:00 UTC
pipeline_git_ref  = "main"
data_bucket_name  = "my-threat-watch-data"  # must be globally unique

# OpenCTI — disabled
opencti_deploy = false

# Optional: extra secrets stored in SSM
# pipeline_env_vars = {
#   SLACK_TOKEN = "/threat-intel/prod/slack_token"
# }

# Optional: restrict SSH access to a key pair
# key_pair_name = "my-key-pair"
